# The default is a private implementation preview. No public lead collection.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_RELEASE_MODE=preview
ENQUIRIES_ENABLED=false
ENQUIRY_DB_PATH=.data/enquiries.sqlite
# Set all of these to approved values before enabling public collection.
OPERATING_ENTITY_NAME=
OPERATING_ENTITY_ADDRESS=
PRIVACY_CONTACT=
PRIVACY_NOTICE_VERSION=
ENQUIRY_OWNER=
# HTTPS delivery destination. The worker sends signed JSON, with retries.
ENQUIRY_DELIVERY_URL=
ENQUIRY_DELIVERY_SECRET=
RATE_LIMIT_SECRET=
